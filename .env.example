# ============================================================================
# .env.example —— .env 的模板（**本文件可以提交**，不含真实密钥）
# ============================================================================
# 用法：
#   cp .env.example .env      # 复制一份
#   # 然后编辑 .env，填入 DEEPSEEK_API_KEY
#
# 加载方式：`config.py` 与 `run.sh` 都会自动读取 `.env`；
#   已经 `export` 的同名环境变量优先，不会被 .env 覆盖。
#
# 完整可调项见 config.py（9 个分区）与 README 第 2 节。
# ============================================================================


# ---------------------------------------------------------------------------
# LLM 凭据 —— **唯一必填项**
# ---------------------------------------------------------------------------
# 从 https://platform.deepseek.com 获取
DEEPSEEK_API_KEY=sk-your-key-here


# ---------------------------------------------------------------------------
# 可选覆盖（取消注释生效，默认值见 config.py）
# ---------------------------------------------------------------------------
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# PORT=3000
# USE_SSL=0
# DEMO_MODE=0

# ASR_DEVICE=cuda:0
# TTS_DEVICE=cuda:0
# RAG_DEVICE=cpu

# KOKORO_SPEED=1.0                  # 音色固定 af_heart，不可配

# LLM_MAX_HISTORY=30
# RAG_SCORE_THRESHOLD=0.35
# IDLE_TIMEOUT_S=15
# IDLE_GOODBYE_S=30

# GREETING_TEXT=Hi, I'm your IELTS speaking coach. What would you like to practise today?
# IDLE_PROMPT_TEXT=Are you still there? Shall we keep going?
# IDLE_GOODBYE_TEXT=Okay, talk to you next time. Good luck with your IELTS!
